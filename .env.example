DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# ur discord id
DISCORD_OWNER_ID=
MINECRAFT_USERNAME=
# optional multiple accs
# authenticate each with npm run auth:account -- 1 (then 2).
MINECRAFT_ACCOUNTS=
REPLAY_DATABASE=./data/replays.sqlite
# optional channel id to post replays in
REPLAY_RECENT_CHANNEL_ID=

# Card styles: inventory, carbon, arena, studio, off
REPLAY_CARD_STYLE=inventory
# different styles ex:
# REPLAY_PLAYER_CARD_STYLE=arena
# REPLAY_GAME_CARD_STYLE=carbon

# optional admin website
# key in .env.web
SCORITY_WEB_KEY=
SCORITY_WEB_HOST=127.0.0.1
SCORITY_WEB_PORT=3080
